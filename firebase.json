{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "site": "hairandnature-ca",
    "redirects": [
      {
        "source": "/",
        "destination": "https://hairandnature--hair-nature-2026.us-east4.hosted.app",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://hairandnature--hair-nature-2026.us-east4.hosted.app/:path",
        "type": 301
      }
    ]
  },
  "apphosting": {
    "backendId": "hairandnature",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  }
}
